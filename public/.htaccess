# SPA fallback: serve index.html for client-side routes (/dashboard, etc.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Last-resort fallback if mod_rewrite is disabled
ErrorDocument 404 /index.html
